# by Claude - Testing configuration for Lightning Server + KiteUI projects
# Edit this file to customize ports and paths for your project

# Ports (change to avoid conflicts with other projects)
# Deliberately distinct from the dev convention (8090/8091, see root settings.json) so a test run
# can boot without colliding with - or silently talking to - a dev server already running. See
# testing/settings.json (BACKEND_PORT is threaded into ktorRunConfig.port at setup.sh's
# --settings load) and demo-apps/vite/vite.config.mjs (reads these via process.env).
BACKEND_PORT=8020
FRONTEND_PORT=8021

# Timeouts (seconds)
BACKEND_STARTUP_TIMEOUT=90
FRONTEND_STARTUP_TIMEOUT=120

# Gradle tasks (override if different from defaults)
BACKEND_RUN_TASK=":demo-server:run"
FRONTEND_RUN_TASK=":demo-apps:jsViteDev"
FRONTEND_BUILD_TASK=":demo-apps:jsBrowserDevelopmentVitePrepare"
BACKEND_BUILD_TASK=":demo-server:compileKotlin"

# Settings file (relative to testing directory)
SETTINGS_FILE="${LK_TESTING_DIR}/settings.json"

# Log files (auto-created in testing directory)
BACKEND_LOG="${LK_TESTING_DIR}/.backend.log"
FRONTEND_LOG="${LK_TESTING_DIR}/.frontend.log"
ADMIN_TOKEN_FILE="${LK_TESTING_DIR}/.admin-token"
